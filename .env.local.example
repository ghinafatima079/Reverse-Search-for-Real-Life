# Copy this file to .env.local and fill in your keys.
# Do NOT commit your real keys.

# Google Vision API key (optional)
 
# Gemini / Generative API key (optional)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=your-gemini-model-name
# Optional: parser model to run a small text extraction pass (defaults to GEMINI_MODEL when unset)
# GEMINI_PARSER_MODEL=your-parser-model-name

# Local mock mode for testing without real API keys
# USE_MOCK=true

